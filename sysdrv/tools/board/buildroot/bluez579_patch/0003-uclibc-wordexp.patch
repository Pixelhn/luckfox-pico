Subject: [PATCH] Use GLib quoted argument parsing on RV1106 uClibc

No shell evaluation or command substitution.

--- a/client/main.c
+++ b/client/main.c
@@ -18,7 +18,7 @@
 #include <unistd.h>
 #include <stdlib.h>
 #include <stdbool.h>
-#include <wordexp.h>
+#include "android/compat/wordexp.h"
 
 #include <glib.h>
 
--- a/client/player.c
+++ b/client/player.c
@@ -24,7 +24,7 @@
 #include <string.h>
 #include <sys/ioctl.h>
 #include <sys/uio.h>
-#include <wordexp.h>
+#include "android/compat/wordexp.h"
 #include <sys/timerfd.h>
 #include <sys/stat.h>
 
